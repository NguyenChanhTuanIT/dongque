# Firebase web app config (Firebase Console → Project settings → Your apps → Web app).
# Copy this file to .env and fill in the values. These are public client
# identifiers, not secrets; access is enforced by firestore.rules.
# Leave them empty to run the game on its built-in defaults without Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
